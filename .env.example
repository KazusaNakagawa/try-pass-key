# Copy to .env to override. Defaults are set in compose.yaml.
# The browser-facing origin. WebAuthn binds credentials to RP_ID.
RP_ID=localhost
# Host port for the web UI. RP_ORIGIN defaults to http://localhost:${WEB_PORT}.
WEB_PORT=5173
# RP_ORIGIN=http://localhost:5173
# Poll for file changes (server: tsx watch, web: Vite). Docker on macOS does not
# deliver change events on bind mounts, so the default is true.
WATCH_POLLING=true
