{
  "name": "try-pass-key",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.19.0",
  "workspaces": [
    "shared",
    "server",
    "web",
    "e2e"
  ],
  "scripts": {
    "check": "yarn typecheck && yarn lint && yarn test",
    "typecheck": "yarn workspaces foreach --all --exclude try-pass-key run typecheck",
    "lint": "eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "test": "yarn workspaces foreach --all --exclude try-pass-key run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
